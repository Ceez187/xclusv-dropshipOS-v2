SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=
ALLOWED_ORIGIN=http://localhost:5173
PORT=8080

# Signup + login email alerts (optional — see README "Email alerts")
# Sent via Resend's HTTPS API (not SMTP — many hosts, including Render's
# free tier, block outbound SMTP). GMAIL_USER is just the alert recipient
# address, reused by both alert types. WEBHOOK_SECRET is only needed for
# the new-signup webhook (login alerts use the user's session token).
GMAIL_USER=
RESEND_API_KEY=
WEBHOOK_SECRET=
